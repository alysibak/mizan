# Copy to .env.local (dev), .env (Docker Compose), or set the same keys in
# Vercel. Everything is optional; see "Configuration" in the README.

# SQLite via libSQL:
#   Local file (default):  file:mizan.db
#   Turso (free hosted):   libsql://your-db-name-org.turso.io
DATABASE_URL=file:mizan.db

# Required for Turso (ignored for local file: URLs).
# DATABASE_AUTH_TOKEN=

# The public address. Needed at build time for the static pages' canonical
# links and social cards, and for calendar-feed links.
# APP_URL=https://mizan.example

# Who runs this copy, shown in the privacy policy and terms.
# OPERATOR_NAME=Your name or organisation
# CONTACT_EMAIL=you@example.com

# Comma-separated emails that can open /admin/users.
# ADMIN_EMAIL=you@example.com

# Make this account the read-only, one-click demo (seed it with npm run db:seed).
# DEMO_EMAIL=demo@mizan.app

# Email (optional; off unless EMAIL_FROM, APP_URL and a sender are set).
# Lets people confirm their address, reset a forgotten password by link, and
# opt in to a reminder a week before their hawl day and on the day. Messages
# carry a date and a link, never amounts.
# EMAIL_FROM=Mizan <hello@mizan.example>
# RESEND_API_KEY=re_...
# Development: write messages to a file instead of sending them.
# EMAIL_OUTBOX_FILE=/tmp/mizan-outbox.jsonl

# Protects the daily reminder run at /api/cron/reminders. Vercel Cron sends it
# automatically (vercel.json). Self-hosted, call it once a day, e.g. from cron:
#   curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://mizan.example/api/cron/reminders
# CRON_SECRET=a-long-random-string

# Cookieless Plausible analytics on public pages only (build time).
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=mizan.example
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.manual.js

# Host port when using docker compose (the container always listens on 3000).
# PORT=3080
