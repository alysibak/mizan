# Copy this file to .env.local (dev) or set the same keys in Vercel.

# SQLite via libSQL:
#   Local file (default):  file:mizan.db
#   Turso (free hosted):   libsql://your-db-name-org.turso.io
DATABASE_URL=file:mizan.db

# Required for Turso (and ignored for local file: URLs).
# DATABASE_AUTH_TOKEN=

# Secret reserved for future signed tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=replace-with-a-long-random-string

# Host port when using docker compose (container always listens on 3000)
# PORT=3080
